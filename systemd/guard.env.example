# guard.env.example — шаблон для /opt/dsh/dsh-guard/guard.env (без секретов; CHAT_ID подставляется install.sh).
# Секретный токен сторож берёт сам из TG_ENV (TELEGRAM_BOT_TOKEN).
POLL=${POLL:-30}
DEBOUNCE=${DEBOUNCE:-30}
HOT=${HOT:-180}
WARM=${WARM:-600}
HARD_HOT=${HARD_HOT:-90}
HARD_WARM=${HARD_WARM:-300}
CANARY_CONFIRM=${CANARY_CONFIRM:-600}
MIN_LLM=${MIN_LLM:-1}
MIN_SIZE=${MIN_SIZE:-5000}
STRUCT_DROP=${STRUCT_DROP:-0.3}
DISK_MIN_MB=${DISK_MIN_MB:-500}
BASELINE_EVERY=${BASELINE_EVERY:-86400}
TG_ENV=${TG_ENV:-/opt/dsh/telegram.env}
CHAT_ID=${TELEGRAM_ALLOWED_CHAT_ID}
CANARIES=${CANARIES:-mcp-jev,messenger,permission}
