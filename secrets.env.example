# secrets.env.example — имена переменных без значений. Заполнить и положить в /root/secrets.env (chmod 600).
# Telegram (мессенджер-плагин + сторож)
DSH_TELEGRAM_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_ID=
# Провайдеры LLM (см. apiKeyEnv в profile/cordis.patch.yml.template)
FREELLM_BALANCE_KEY=
FREELLM_FAST_KEY=
NEWAPI_KEY=
OPENROUTER_API_KEY=
LMSTUDIO_API_KEY=
HELPCODER_API_KEY=
ZAI_CODING_CN_API_KEY=
ANYMODEL_API_KEY=
TOKENATOR_API_KEY=
# Сторож dsh-guard (guard.env; дефолты в plugins/dsh-guard/dsh-guard.py)
POLL=30
DEBOUNCE=30
HOT=180
WARM=600
HARD_HOT=90
HARD_WARM=300
CANARY_CONFIRM=600
MIN_LLM=1
MIN_SIZE=5000
STRUCT_DROP=0.3
DISK_MIN_MB=500
BASELINE_EVERY=86400
TG_ENV=/opt/dsh/telegram.env
CANARIES=mcp-jev,messenger,permission
