# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
# dsh-skill-folder (2026-10-02, npm 0.3.4): статический cache-stable каталог
# скиллов + skill_search (BM25) + autoRoute <skill-route> хинт. Самописный
# dsh-skill-hinter полностью удалён (источник сохранён в /opt/projects/<harness>/dsh-skill-hinter).
- insert:
    - id: skill-folder
      name: 'dsh-skill-folder'
      config:
        # Ollama не ставим: ресурсов нет; skill_search = BM25, каталог в контексте даёт ≥95% на skill-eval
        semanticEnabled: false
        # Алиасы: ТОЛЬКО однозначные фразы (совпало 2+ скиллов → подсказки не будет; точность важнее покрытия).
        # Алиас — устойчивая командная фраза/специфичный термин ≥4 симв. (исключения: tdd, cdp, dpi).
        # Метрики 2026-10-07 p6 (88 скиллов, 350 фраз, пул только активных скиллов):
        #   cases.json 360 кейсов: 67.8% coverage / 0 wrong;
        #   heldout 105 (независимый): 27.6% / 1 wrong — name-token FP «transition'ами»→view-transitions,
        #     этап name-token плагина, алиасами не лечится без подгонки под тест;
        #   alias-holdout 70 (60 intent + 10 no-intent): 78.6% / 0 wrong, no-intent чисты.
